    "Location is used only while the app is open. You can skip this and turn it on later." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalitet bruges kun, mens appen er åben. Du kan springe dette over og slå det til senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standort wird nur verwendet, solange die App geöffnet ist. Du kannst das überspringen und später aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación solo se usa mientras la app está abierta. Puedes omitir esto y activarla más tarde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sijaintia käytetään vain, kun sovellus on auki. Voit ohittaa tämän ja ottaa sen käyttöön myöhemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La position n'est utilisée que pendant que l'app est ouverte. Vous pouvez passer cette étape et l'activer plus tard."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staðsetning er aðeins notuð meðan appið er opið. Þú getur sleppt þessu og kveikt á henni síðar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La posizione viene usata solo mentre l'app è aperta. Puoi saltare questo passaggio e attivarla più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報は、アプリを開いている間だけ使われます。今はスキップして、あとからオンにすることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치는 앱을 열어 둔 동안에만 사용돼요. 지금은 건너뛰고 나중에 켤 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posisjon brukes bare mens appen er åpen. Du kan hoppe over dette og slå på posisjon senere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalizacja jest używana tylko wtedy, gdy aplikacja jest otwarta. Możesz to pominąć i włączyć później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A localização é usada somente enquanto o app está aberto. Você pode pular isso e ativar depois."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platsen används bara medan appen är öppen. Du kan hoppa över detta och aktivera det senare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在应用打开时使用定位。你可以跳过此步骤，稍后再开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
