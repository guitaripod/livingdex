    },
    "Everything you catch from here is the real thing, rated by how rare it is where you are." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was du ab jetzt fängst, ist echt und wird nach seiner Seltenheit an deinem Standort bewertet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que captures a partir de ahora será real, valorado según su rareza donde estés."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que vous capturez désormais est bien réel, et noté selon sa rareté là où vous vous trouvez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che catturerai da ora in poi è autentico, valutato in base a quanto è raro dove ti trovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここから捕まえるものはすべて本物で、あなたの地域でどれだけ希少かによって評価されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 잡는 모든 것은 진짜이며, 여러분의 지역에서 얼마나 드문지에 따라 등급이 매겨져요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko, co złapiesz od teraz, jest prawdziwe i oceniane pod kątem tego, jak rzadkie jest w Twojej okolicy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que você capturar a partir daqui será real, classificado pelo quão raro é onde você está."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从现在起，你捕获的一切都是真实的，并按它在你所在地的稀有程度评级。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從現在起，你捕獲的每一個都是真實的，並依其在你所在地的稀有程度評級。"
          }
        }
      }
    },
