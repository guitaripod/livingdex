    "Out of identifications — add credits or go Pro" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen identifikationer tilbage. Tilføj kreditter eller opgrader til Pro"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Identifizierungen mehr. Credits hinzufügen oder auf Pro umsteigen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin identificaciones: añade créditos o hazte Pro"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnistuksia on loppu: lisää krediittejä tai siirry Pro-versioon"
          }
        },
        "fr" : {
