    },
    "You've used your free identifications. Go Pro for unlimited identifications, or add credits to keep identifying." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast deine kostenlosen Identifizierungen aufgebraucht. Werde Pro für unbegrenzte Identifizierungen oder kaufe Credits, um weiter zu identifizieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has usado tus identificaciones gratuitas. Hazte Pro para identificaciones ilimitadas o añade créditos para seguir identificando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez utilisé vos identifications gratuites. Passez à Pro pour des identifications illimitées, ou ajoutez des crédits pour continuer à identifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai esaurito le identificazioni gratuite. Passa a Pro per identificazioni illimitate o aggiungi crediti per continuare a identificare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料の識別回数を使い切りました。Pro にして識別し放題にするか、クレジットを追加して識別を続けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 식별 횟수를 모두 사용했어요. Pro로 식별을 무제한으로 쓰거나, 크레딧을 추가해 계속 식별하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykorzystano darmowe identyfikacje. Przejdź na Pro, by identyfikować bez limitów, lub dokup kredyty, by dalej identyfikować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você usou suas identificações grátis. Assine o Pro para identificações ilimitadas ou adicione créditos para continuar identificando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已用完免费识别次数。升级 Pro 即可无限次识别，或添加积分以继续识别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已用完免費識別次數。升級 Pro 即可無限次識別，或新增點數以繼續識別。"
          }
        }
      }
    },
    "Your Dex is always free" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Dex ist immer kostenlos"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Dex siempre es gratis"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Dex est toujours gratuit"
          }
        },
        "it" : {
