    "Bird and animal sound recordings, with attribution" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vogel- und Tierstimmen-Aufnahmen, mit Quellenangabe"
          }
        },
        "es" : {
