            "value" : "Un tomate, una hoja de roble o una piña"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomaatti, tammen lehti tai männynkäpy"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une tomate, une feuille de chêne ou une pomme de pin"
          }
        },
        "is" : {
