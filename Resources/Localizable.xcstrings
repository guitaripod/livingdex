    "We couldn't restore your purchases. Check your connection and try again." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunne ikke gendanne dine køb. Tjek din forbindelse, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten deine Käufe nicht wiederherstellen. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos restaurar tus compras. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostojasi ei voitu palauttaa. Tarkista yhteytesi ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous n'avons pas pu restaurer vos achats. Vérifiez votre connexion et réessayez."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okkur tókst ekki að endurheimta kaupin þín. Athugaðu tenginguna og reyndu aftur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non siamo riusciti a ripristinare i tuoi acquisti. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入を復元できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매를 복원하지 못했어요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunne ikke gjenopprette kjøpene dine. Sjekk tilkoblingen din og prøv igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się przywrócić zakupów. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível restaurar suas compras. Verifique sua conexão e tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunde inte återställa dina köp. Kontrollera anslutningen och försök igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们无法恢复你的购买项目。请检查网络连接后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們無法恢復你的購買項目。請檢查網路連線後再試一次。"
          }
        }
      }
    },
