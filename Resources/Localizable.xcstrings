            "state" : "translated",
            "value" : "此 Apple ID 沒有可恢復的先前購買項目。"
          }
        }
      }
    },
    "They drink sunlight." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie trinken Sonnenlicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beben luz solar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles boivent la lumière du soleil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevono luce solare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日光を飲んで生きています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "햇빛을 마시며 살아요."
          }
        },
        "pl" : {
