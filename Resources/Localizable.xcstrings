    "Fungi" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svampe"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilze"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hongos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sienet"
          }
        },
        "fr" : {
          "stringUnit" : {
