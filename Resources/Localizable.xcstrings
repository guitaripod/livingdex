    "Catch something nearby to start your Regional Dex." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fang noget i nærheden for at starte dit regionale Dex."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fang etwas in der Nähe, um deinen regionalen Dex zu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captura algo cercano para empezar tu Dex regional."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloita alueellinen Dex saamalla kiinni jokin lähellä oleva laji."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturez quelque chose à proximité pour lancer votre Dex régional."
