    "No payment due now. %lld days free, then %@/month. Cancel anytime." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen betaling nu. %lld dage gratis, derefter %@/måned. Opsig når som helst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute keine Zahlung. %lld Tage gratis, danach %@/Monat. Jederzeit kündbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ningún cargo ahora. %lld días gratis, después %@/mes. Cancela cuando quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei veloitusta nyt. %lld päivää ilmaiseksi, sen jälkeen %@ kuukaudessa. Peruuta milloin tahansa."
