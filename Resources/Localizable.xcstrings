    "There were no previous purchases to restore for this Apple ID." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Apple-ID gab es keine früheren Käufe zum Wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No había compras anteriores que restaurar con este ID de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun achat antérieur à restaurer pour cet identifiant Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c'erano acquisti precedenti da ripristinare per questo ID Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Apple ID には、復元できる以前の購入はありません。"
          }
        },
        "ko" : {
