    "Subscriptions auto-renew unless cancelled at least 24h before the period ends. Manage in your Apple ID settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abos verlängern sich automatisch, sofern sie nicht mindestens 24 Stunden vor Ende des Zeitraums gekündigt werden. Verwalte sie in deinen Apple-ID-Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones se renuevan automáticamente salvo que se cancelen al menos 24 h antes de que acabe el periodo. Gestiónalas en los ajustes de tu ID de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements se renouvellent automatiquement sauf résiliation au moins 24 h avant la fin de la période. Gérez-les dans les réglages de votre identifiant Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli abbonamenti si rinnovano automaticamente a meno che non vengano disdetti almeno 24 ore prima della fine del periodo. Gestiscili nelle impostazioni del tuo ID Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションは、期間終了の24時間前までに解約しない限り自動更新されます。Apple ID の設定で管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독은 기간이 끝나기 24시간 전까지 해지하지 않으면 자동 갱신돼요. Apple ID 설정에서 관리할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskrypcje odnawiają się automatycznie, chyba że zostaną anulowane co najmniej 24 godziny przed końcem okresu. Zarządzaj nimi w ustawieniach Apple ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As assinaturas são renovadas automaticamente, a menos que sejam canceladas pelo menos 24 horas antes do fim do período. Gerencie nos ajustes do seu Apple ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅会自动续订，除非在当前周期结束前至少 24 小时取消。请在你的 Apple ID 设置中管理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱會自動續訂，除非在目前週期結束前至少 24 小時取消。請在你的 Apple ID 設定中管理。"
          }
        }
      }
    },
