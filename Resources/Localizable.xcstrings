    "Sent over an encrypted connection, and only when you identify. Nothing uploads in the background." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird über eine verschlüsselte Verbindung gesendet, und nur wenn du identifizierst. Im Hintergrund wird nichts hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envía por una conexión cifrada, y solo cuando identificas. Nada se sube en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
