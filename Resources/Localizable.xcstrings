    "A %@ animal lives near you. Find it in the field to add it to your dex." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tier (%@) lebt in deiner Nähe. Finde es draußen, um es deinem Dex hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca de ti vive un animal de rareza %@. Encuéntralo en el campo para añadirlo a tu Dex."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un animal (%@) vit près de vous. Trouvez-le sur le terrain pour l'ajouter à votre Dex."
