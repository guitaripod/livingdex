    "Something went wrong on our side. Nothing was deleted, so try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf unserer Seite ist etwas schiefgelaufen. Es wurde nichts gelöscht, also versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
