    "Sent over an encrypted connection, and only when you identify. Nothing uploads in the background." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendes over en krypteret forbindelse, og kun når du identificerer. Intet uploades i baggrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird über eine verschlüsselte Verbindung gesendet, und nur wenn du identifizierst. Im Hintergrund wird nichts hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envía por una conexión cifrada, y solo cuando identificas. Nada se sube en segundo plano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetetään salatun yhteyden kautta, ja vain kun tunnistat. Taustalla ei lähetetä mitään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyé par une connexion chiffrée, et seulement lorsque vous identifiez. Rien n'est envoyé en arrière-plan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myndin er send um dulkóðaða tengingu, og aðeins þegar þú greinir. Ekkert er hlaðið upp í bakgrunni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviata tramite connessione cifrata, e solo quando identifichi. Nulla viene caricato in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化された接続で、識別するときだけ送信されます。バックグラウンドで何もアップロードされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화된 연결로, 식별할 때만 전송돼요. 백그라운드에서 아무것도 업로드되지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendes over en kryptert tilkobling, og bare når du identifiserer. Ingenting lastes opp i bakgrunnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłane szyfrowanym połączeniem i tylko wtedy, gdy identyfikujesz. Nic nie jest wysyłane w tle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviada por conexão criptografada, e somente quando você identifica. Nada é enviado em segundo plano."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skickas över en krypterad anslutning, och endast när du identifierar. Inget laddas upp i bakgrunden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在你识别时，通过加密连接发送。绝不会在后台上传任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在你識別時，透過加密連線傳送。絕不會在背景上傳任何內容。"
          }
        }
      }
    },
