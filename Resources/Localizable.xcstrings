    },
    "Your Dex is growing. Pro keeps you identifying without limits, anywhere life turns up." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit Dex vokser. Med Pro kan du identificere uden begrænsninger, uanset hvor livet dukker op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Dex wächst. Pro hält dich ohne Grenzen am Identifizieren, überall, wo Leben auftaucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Dex está creciendo. Pro te permite identificar sin límites, allí donde aparezca la vida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dexisi kasvaa. Pro antaa rajattomat tunnistukset missä tahansa elämää ilmaantuukin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Dex grandit. Pro vous permet d'identifier sans limites, partout où la vie se manifeste."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dex-inn þinn er að vaxa. Pro heldur þér áfram að greina án takmarkana, hvar sem líf kemur í ljós."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo Dex sta crescendo. Pro ti permette di identificare senza limiti, ovunque compaia la vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dex が育っています。Pro なら、生命が現れる場所で、制限なく識別し続けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dex가 자라고 있어요. Pro를 쓰면 생명이 나타나는 곳이라면 어디서든 제한 없이 계속 식별할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dex-en din vokser. Pro holder deg i gang med å identifisere uten begrensninger, uansett hvor liv dukker opp."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój Dex rośnie. Pro pozwala identyfikować bez limitów, gdziekolwiek pojawi się życie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Dex está crescendo. O Pro permite identificar sem limites, onde quer que a vida apareça."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt Dex växer. Pro låter dig identifiera utan gräns, var livet än dyker upp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Dex 正在成长。Pro 让你无限制识别，无论在哪里遇到生命。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Dex 正在成長。Pro 讓你無論在哪裡遇到生命，都能無限制識別。"
          }
        }
      }
    },
    "Your Dex is ready. Pro lets you fill it as fast as you find things." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit Dex er klar. Med Pro kan du fylde det lige så hurtigt, som du finder ting."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Dex ist bereit. Mit Pro füllst du ihn so schnell, wie du Neues entdeckst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Dex está listo. Con Pro lo llenas tan rápido como encuentras cosas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dexisi on valmis. Pro antaa täyttää sen yhtä nopeasti kuin löydät uusia lajeja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Dex est prêt. Avec Pro, remplissez-le aussi vite que vous faites des découvertes."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dex-inn þinn er tilbúinn. Með Pro fyllir þú hann eins hratt og þú finnur nýtt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo Dex è pronto. Con Pro lo riempi alla stessa velocità con cui scopri le cose."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dex の準備ができました。Pro なら、見つけた分だけどんどん埋められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dex가 준비됐어요. Pro와 함께라면 발견하는 만큼 빠르게 채울 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dex-en din er klar. Med Pro fyller du den like raskt som du finner nye ting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój Dex jest gotowy. Z Pro wypełnisz go tak szybko, jak odkrywasz nowe rzeczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Dex está pronto. Com o Pro, você o preenche tão rápido quanto encontra coisas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt Dex är redo. Med Pro fyller du det så fort du hittar saker."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Dex 已就绪。有了 Pro，发现多快，就能填得多快。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Dex 已就緒。有了 Pro，發現多快，就能填得多快。"
          }
        }
      }
    },
    "Your Dex, Nearby and field entries stay free. Every device starts with 30 free identifications, and everything you catch stays yours." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit Dex, fanen I nærheden og dine feltposter forbliver gratis. Hver enhed starter med 30 gratis identifikationer, og alt, du fanger, forbliver dit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Dex, „In der Nähe“ und die Feldeinträge bleiben kostenlos. Jedes Gerät startet mit 30 kostenlosen Identifizierungen, und alles, was du fängst, bleibt deins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Dex, Cercanos y las fichas de campo siguen siendo gratis. Cada dispositivo empieza con 30 identificaciones gratuitas, y todo lo que captures sigue siendo tuyo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dexisi, Lähellä-välilehti ja kenttämerkinnät pysyvät ilmaisina. Jokainen laite alkaa 30 ilmaisella tunnistuksella, ja kaikki saamasi saaliit ovat sinun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Dex, « À proximité » et les fiches de terrain restent gratuits. Chaque appareil commence avec 30 identifications gratuites, et tout ce que vous capturez vous appartient."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dex-inn þinn, „Í nágrenninu“ og vettvangsfærslur eru áfram ókeypis. Hvert tæki byrjar með 30 ókeypis greiningum og allt sem þú nærð er áfram þitt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo Dex, Vicino a te e le schede sul campo restano gratis. Ogni dispositivo inizia con 30 identificazioni gratuite, e tutto ciò che catturi resta tuo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dex、「近く」、フィールドの記録はずっと無料です。どの端末も最初に無料で30回識別でき、捕獲したものはずっとあなたのものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dex, '주변', 필드 기록은 계속 무료예요. 모든 기기는 무료 식별 30회로 시작하고, 포획한 것은 모두 계속 여러분의 것이에요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dex-en din, «I nærheten» og feltpostene forblir gratis. Hver enhet starter med 30 gratis identifiseringer, og alt du fanger er ditt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój Dex, W pobliżu i wpisy terenowe pozostają darmowe. Każde urządzenie zaczyna z 30 darmowymi identyfikacjami, a wszystko, co złapiesz, pozostaje Twoje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Dex, Por perto e as entradas de campo continuam grátis. Todo dispositivo começa com 30 identificações grátis, e tudo o que você capturar continua sendo seu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt Dex, I närheten och fältposter är kostnadsfria. Varje enhet börjar med 30 gratis identifieringar, och allt du fångar är ditt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Dex、“附近”和野外条目始终免费。每台设备起始赠送 30 次免费识别，你捕获的一切都归你所有。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Dex、「附近」和野外條目始終免費。每台裝置起始贈送 30 次免費識別，你捕獲的一切都屬於你。"
          }
        }
      }
    },
    "Your Nearby tab lists the wild species recorded around you as locked slots. Catch one to unlock it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanen I nærheden viser de vilde arter, der er registreret omkring dig, som låste pladser. Fang en for at låse den op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Reiter „In der Nähe“ listet die wild lebenden Arten in deiner Umgebung als gesperrte Plätze auf. Fang eine, um sie freizuschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pestaña Cercanos enumera las especies silvestres registradas a tu alrededor como huecos bloqueados. Captura una para desbloquearla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähellä-välilehdellä listataan ympäristössäsi havaitut villit lajit lukittuina paikkoina. Saa yksi kiinni, niin se avautuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'onglet « À proximité » liste les espèces sauvages enregistrées autour de vous sous forme d'emplacements verrouillés. Capturez-en une pour la débloquer."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipinn „Í nágrenninu“ listar villtar tegundir sem skráðar eru í kringum þig sem læsta reiti. Náðu eina til að opna hana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scheda Vicino a te elenca le specie selvatiche registrate intorno a te come slot bloccati. Catturane una per sbloccarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「近く」タブには、近くで記録された野生の種がロックされたスロットとして並びます。捕まえるとロックが解除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'주변' 탭에는 근처에서 기록된 야생 종이 잠긴 슬롯으로 나열돼요. 하나를 잡으면 잠금이 풀려요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanen «I nærheten» viser de ville artene som er registrert rundt deg, som låste plasser. Fang en for å låse den opp."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakładka W pobliżu wyświetla dzikie gatunki zarejestrowane wokół Ciebie jako zablokowane miejsca. Złap jeden, by go odblokować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua aba Por perto lista as espécies selvagens registradas ao seu redor como espaços bloqueados. Capture uma para desbloqueá-la."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fliken I närheten visar de vilda arter som registrerats runt dig som låsta platser. Fånga en för att låsa upp den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的“附近”标签页会以未解锁栏位的形式列出你周围记录到的野生物种。捕获其中一种即可解锁它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的「附近」頁籤會以未解鎖欄位的形式，列出你周圍記錄到的野生物種。捕獲其中一種即可解鎖它。"
          }
        }
      }
    },
    "Your account was deleted from our servers, but some data couldn't be removed from this device. Deleting the app removes the rest." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din konto er slettet fra vores servere, men nogle data kunne ikke fjernes fra denne enhed. Når du sletter appen, fjernes resten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto wurde von unseren Servern gelöscht, aber einige Daten konnten nicht von diesem Gerät entfernt werden. Wenn du die App löschst, werden die restlichen entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta se eliminó de nuestros servidores, pero algunos datos no se pudieron borrar de este dispositivo. Al borrar la app se eliminará el resto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilisi on poistettu palvelimiltamme, mutta joitakin tietoja ei voitu poistaa tältä laitteelta. Sovelluksen poistaminen poistaa loput."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte a été supprimé de nos serveurs, mais certaines données n'ont pas pu être retirées de cet appareil. Supprimer l'app efface le reste."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aðgangur þinn var eyddur af þjónum okkar, en ekki tókst að fjarlægja sum gögn úr þessu tæki. Eyðing appsins fjarlægir restina."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account è stato eliminato dai nostri server, ma alcuni dati non è stato possibile rimuoverli da questo dispositivo. Eliminare l'app rimuove il resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントはサーバーから削除されましたが、一部のデータはこの端末から削除できませんでした。アプリを削除すると残りも消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정은 서버에서 삭제됐지만, 일부 데이터는 이 기기에서 삭제할 수 없었어요. 앱을 삭제하면 나머지도 지워져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontoen din er slettet fra serverne våre, men noen data kunne ikke fjernes fra denne enheten. Når du sletter appen, fjernes resten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto zostało usunięte z naszych serwerów, ale niektórych danych nie udało się usunąć z tego urządzenia. Usunięcie aplikacji usunie resztę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta foi excluída dos nossos servidores, mas alguns dados não puderam ser removidos deste aparelho. Excluir o app remove o restante."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt konto raderades från våra servrar, men vissa data kunde inte tas bort från den här enheten. Om du raderar appen tas resten bort."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的账户已从我们的服务器删除，但此设备上的部分数据无法移除。删除应用即可清除其余数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的帳號已從我們的伺服器刪除，但此裝置上的部分資料無法移除。刪除應用程式即可清除其餘資料。"
          }
        }
      }
    },
    "Your dex is empty" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit Dex er tomt"
          }
