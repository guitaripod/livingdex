          }
        }
      }
    },
    "You start with 30 free identifications. A photo is sent to cloud AI only after you say yes, and never before." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du starter med 30 gratis identifikationer. Et foto sendes kun til cloud-AI, når du har sagt ja, og aldrig før."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du startest mit 30 kostenlosen Identifizierungen. Ein Foto wird erst dann an Cloud-KI gesendet, wenn du zustimmst, niemals vorher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empiezas con 30 identificaciones gratuitas. Una foto se envía a la IA en la nube solo después de que digas que sí, y nunca antes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat alussa 30 ilmaista tunnistusta. Kuva lähetetään pilvi-AI:lle vasta, kun annat luvan, eikä koskaan sitä ennen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous commencez avec 30 identifications gratuites. Une photo n'est envoyée à l'IA dans le cloud qu'après votre accord, et jamais avant."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú byrjar með 30 ókeypis greiningum. Mynd er aðeins send til skýja-gervigreindar eftir að þú segir já, og aldrei áður."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizi con 30 identificazioni gratuite. Una foto viene inviata all'IA nel cloud solo dopo che hai detto di sì, e mai prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初に30回無料で識別できます。写真がクラウド AI に送信されるのは、あなたが同意した後だけで、それ以前には決して送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 식별 30회로 시작해요. 사진은 동의한 뒤에만 클라우드 AI로 전송되며, 그 전에는 절대 전송되지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du starter med 30 gratis identifiseringer. Et bilde sendes til sky-AI først etter at du har sagt ja, og aldri før."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaczynasz z 30 darmowymi identyfikacjami. Zdjęcie jest wysyłane do AI w chmurze dopiero po Twojej zgodzie, nigdy wcześniej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você começa com 30 identificações grátis. Uma foto só é enviada para a IA na nuvem depois que você aceitar, e nunca antes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du börjar med 30 gratis identifieringar. Ett foto skickas till moln-AI först när du har sagt ja, aldrig innan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你起始拥有 30 次免费识别。照片只有在你同意后才会发送至云端 AI，绝不会在此之前发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你起始擁有 30 次免費識別。只有在你同意後才會將照片傳送至雲端 AI，在此之前絕不會傳送。"
          }
        }
      }
    },
    "You were not charged. Check your connection and try again." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blev ikke opkrævet. Tjek din forbindelse, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dir wurde nichts berechnet. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se te ha cobrado nada. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinulta ei veloitettu. Tarkista yhteytesi ja yritä uudelleen."
