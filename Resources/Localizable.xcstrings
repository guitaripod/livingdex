    "Try a sample photo to see how a catch works, no creature needed." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv et eksempelfoto for at se, hvordan en fangst fungerer. Du behøver ikke et levende væsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probiere ein Beispielfoto aus, um zu sehen, wie ein Fang funktioniert, ganz ohne Lebewesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba una foto de muestra para ver cómo funciona una captura, sin necesidad de ninguna criatura."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokeile esimerkkikuvaa nähdäksesi, miten saalis toimii, ilman eläintä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez une photo d'exemple pour voir comment se passe une capture, sans avoir d'animal sous la main."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prófaðu sýnismynd til að sjá hvernig fang virkar, engin skepna þarf til."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova una foto di esempio per vedere come funziona una cattura, senza bisogno di alcuna creatura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サンプル写真を試して、捕獲の流れを見てみましょう。生き物は必要ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "샘플 사진으로 포획이 어떻게 이루어지는지 확인해 보세요. 생명체는 필요 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv et eksempelbilde for å se hvordan en fangst fungerer. Du trenger ikke noe levende vesen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wypróbuj przykładowe zdjęcie, by zobaczyć, jak wygląda złapanie, bez potrzeby żadnego stworzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimente uma foto de exemplo para ver como funciona uma captura, sem precisar de nenhum animal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova ett exempelfoto för att se hur en fångst fungerar, inget djur behövs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试用示例照片，看看捕获是怎样进行的，无需对准任何生物。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試用示例照片，看看捕獲是怎麼進行的，無需對準任何生物。"
          }
        }
      }
    },
    "Turn on location to reveal the species living near you — your Regional Dex." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå lokalitet til for at afsløre de arter, der lever i nærheden af dig: dit regionale Dex."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere den Standort, um die Arten in deiner Nähe aufzudecken, deinen regionalen Dex."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa la ubicación para revelar las especies que viven cerca de ti: tu Dex regional."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota sijainti käyttöön, niin näet lajit, jotka elävät lähelläsi, eli alueellisen Dexisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez la localisation pour révéler les espèces qui vivent près de vous : votre Dex régional."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kveiktu á staðsetningu til að afhjúpa tegundirnar sem lifa nálægt þér, svæðisbundna Dex-inn þinn."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva la posizione per rivelare le specie che vivono vicino a te: il tuo Dex regionale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報をオンにして、近くに生息する種、つまり地域の Dex を明らかにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치를 켜서 근처에 사는 종, 즉 지역 Dex를 드러내 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på posisjon for å avdekke artene som lever nær deg, ditt regionalt Dex."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz lokalizację, by odkryć gatunki żyjące w pobliżu: Twój Dex regionalny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative a localização para revelar as espécies que vivem perto de você: seu Dex Regional."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på platstjänster för att avslöja arterna som lever nära dig, ditt Regionalt Dex."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启定位，即可揭晓你附近生活的物种，也就是你的区域 Dex。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟定位，即可揭曉附近生活的物種，也就是你的區域 Dex。"
          }
        }
      }
    },
