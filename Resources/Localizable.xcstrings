    "Some data couldn't be removed from this device. Deleting the app removes the rest." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle data kunne ikke fjernes fra denne enhed. Når du sletter appen, fjernes resten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Daten konnten nicht von diesem Gerät entfernt werden. Wenn du die App löschst, werden die restlichen entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos datos no se pudieron eliminar de este dispositivo. Al borrar la app se eliminará el resto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joitakin tietoja ei voitu poistaa tältä laitteelta. Sovelluksen poistaminen poistaa loput."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines données n'ont pas pu être supprimées de cet appareil. Supprimer l'app efface le reste."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki tókst að fjarlægja sum gögn úr þessu tæki. Eyðing appsins fjarlægir restina."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni dati non è stato possibile rimuoverli da questo dispositivo. Eliminare l'app rimuove il resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のデータはこの端末から削除できませんでした。アプリを削除すると残りも消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 데이터는 이 기기에서 삭제할 수 없었어요. 앱을 삭제하면 나머지도 지워져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen data kunne ikke fjernes fra denne enheten. Når du sletter appen, fjernes resten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektórych danych nie udało się usunąć z tego urządzenia. Usunięcie aplikacji usunie resztę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns dados não puderam ser removidos deste aparelho. Excluir o app remove o restante."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vissa data kunde inte tas bort från den här enheten. Om du raderar appen tas resten bort."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上的部分数据无法删除。删除应用即可清除其余数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置上的部分資料無法移除。刪除應用程式即可清除其餘資料。"
          }
        }
      }
    },
    "Something went wrong on our side. Nothing was deleted, so try again in a moment." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noget gik galt hos os. Intet blev slettet, så prøv igen om et øjeblik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf unserer Seite ist etwas schiefgelaufen. Es wurde nichts gelöscht, also versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo salió mal por nuestra parte. No se borró nada, así que inténtalo de nuevo en un momento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jotain meni pieleen palvelimellamme. Mitään ei poistettu, joten yritä hetken kuluttua uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un problème est survenu de notre côté. Rien n'a été supprimé, réessayez dans un instant."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eitthvað fór úrskeiðis hjá okkur. Ekkert var eytt, svo reyndu aftur eftir augnablik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa è andato storto da parte nostra. Nulla è stato eliminato, quindi riprova tra un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こちら側で問題が発生しました。何も削除されていないので、少ししてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버 쪽에서 문제가 생겼어요. 아무것도 삭제되지 않았으니 잠시 후 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noe gikk galt hos oss. Ingenting ble slettet, så prøv igjen om litt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po naszej stronie coś poszło nie tak. Nic nie zostało usunięte, więc spróbuj ponownie za chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo deu errado do nosso lado. Nada foi excluído, então tente novamente em instantes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något gick fel på vår sida. Inget raderades, så försök igen om en stund."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们这边出了点问题。什么都没有被删除，请稍后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們這邊發生了問題。什麼都沒有被刪除，請稍後再試一次。"
          }
        }
      }
    },
    "Something went wrong releasing that species. Please try again." : {
