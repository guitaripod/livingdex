{
  "sourceLanguage" : "en",
  "strings" : {
    "\"Sea sparkle\" or a colored algal bloom" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»Havglimt« eller en farvet algeopblomstring"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Meeresleuchten“ oder eine farbige Algenblüte"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Chispa del mar\" o una floración de algas de color"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Meren hohde” tai värillinen leväkukinta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Scintillement marin » ou une prolifération d'algues colorées"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Hafglampi“ eða litaður þörungablómi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Scintillio del mare\" o una fioritura di alghe colorate"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「海のきらめき」や色づいた藻類の大量発生"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"바다 반짝임\" 또는 색을 띤 조류 번성"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Sjøglitter» eller en farget algeoppblomstring"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Morski blask\" lub kolorowy zakwit glonów"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Brilho do mar\" ou uma floração colorida de algas"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Havsglitter” eller en färgad algblomning"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“海洋闪光”或彩色藻华"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「海洋閃光」或彩色藻華"
          }
        }
      }
    },
