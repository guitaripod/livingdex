            "value" : "En hund, en kat eller et egern i nabolaget"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Hund, eine Katze oder ein Eichhörnchen in der Nachbarschaft"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un perro, un gato o una ardilla del barrio"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naapuruston koira, kissa tai orava"
          }
        },
        "fr" : {
