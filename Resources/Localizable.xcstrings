{
  "sourceLanguage" : "en",
  "strings" : {
    "\"Sea sparkle\" or a colored algal bloom" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Meeresleuchten“ oder eine farbige Algenblüte"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Chispa del mar\" o una floración de algas de color"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Scintillement marin » ou une prolifération d'algues colorées"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Scintillio del mare\" o una fioritura di alghe colorate"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「海のきらめき」や色づいた藻類の大量発生"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"바다 반짝임\" 또는 색을 띤 조류 번성"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Morski blask\" lub kolorowy zakwit glonów"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Brilho do mar\" ou uma floração colorida de algas"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“海洋闪光”或彩色藻华"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「海洋閃光」或彩色藻華"
          }
        }
      }
    },
    "%@ Pro makes every identification unlimited — no credits to count, no meter to watch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Pro macht jede Identifizierung unbegrenzt: keine Credits zählen, kein Zähler im Blick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ Pro, todas las identificaciones son ilimitadas: sin créditos que contar ni contador que vigilar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Pro rend chaque identification illimitée : plus de crédits à compter, plus de compteur à surveiller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ Pro ogni identificazione è illimitata: niente crediti da contare, nessun contatore da controllare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Pro なら識別し放題です。数えるクレジットも、気にするメーターもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Pro를 쓰면 모든 식별이 무제한이에요. 셀 크레딧도, 확인할 잔량도 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Pro sprawia, że każda identyfikacja jest nieograniczona, bez liczenia kredytów i pilnowania licznika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Pro torna cada identificação ilimitada, sem créditos para contar nem medidor para acompanhar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Pro 让每次识别都不受限制，无需计算积分，也无需留意余额。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Pro 讓每次識別都不受限制，不必計算點數，也不必留意餘額。"
          }
        }
      }
    },
