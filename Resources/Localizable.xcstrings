    "For walks where every hedge hides something new." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til gåture, hvor hver hæk gemmer på noget nyt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Spaziergänge, bei denen hinter jeder Hecke etwas Neues wartet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para paseos en los que cada seto esconde algo nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kävelyretkille, joilla jokainen pensasaita kätkee jotain uutta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les balades où chaque haie cache quelque chose de nouveau."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyrir göngutúra þar sem hvert limgerði felur eitthvað nýtt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per le passeggiate in cui ogni siepe nasconde qualcosa di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの茂みにも新しい発見が隠れている、そんな散歩のために。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "덤불마다 새로운 무언가가 숨어 있는 산책을 위해."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For turer der hver hekk skjuler noe nytt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na spacery, na których za każdym żywopłotem kryje się coś nowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para caminhadas em que cada arbusto esconde algo novo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För promenader där varje häck döljer något nytt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "献给每丛灌木后都藏着新发现的散步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "獻給每叢灌木後都藏著新發現的散步。"
          }
        }
      }
    },
