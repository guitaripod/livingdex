    "Tap the shutter at anything alive: a bird, a bug, a mushroom, a flower." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på udløseren ved alt, der lever: en fugl, et insekt, en svamp eller en blomst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf den Auslöser bei allem, was lebt: ein Vogel, ein Insekt, ein Pilz, eine Blume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa el obturador ante cualquier ser vivo: un pájaro, un insecto, un hongo, una flor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta laukaisinta mitä tahansa elävää kohti: lintua, hyönteistä, sientä tai kukkaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le déclencheur pour tout ce qui est vivant : un oiseau, un insecte, un champignon, une fleur."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ýttu á lokarann fyrir allt sem lifir: fugl, skordýr, sveppur, blóm."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca l'otturatore su qualsiasi essere vivente: un uccello, un insetto, un fungo, un fiore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鳥、虫、キノコ、花など、生きているものでシャッターをタップしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새, 벌레, 버섯, 꽃 등 살아 있는 무엇이든 셔터를 탭하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på utløseren mot alt som lever: en fugl, et insekt, en sopp, en blomst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij migawki, celując w coś żywego: ptaka, owada, grzyba, kwiat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no obturador para qualquer ser vivo: um pássaro, um inseto, um cogumelo, uma flor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på avtryckaren för allt levande: en fågel, en insekt, en svamp, en blomma."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对准任何生物点按快门：鸟、虫、蘑菇或花朵。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對準任何生物，按下快門：鳥、昆蟲、蘑菇或花朵。"
          }
        }
      }
    },
