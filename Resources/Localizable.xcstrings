    "Tap the shutter at anything alive: a bird, a bug, a mushroom, a flower." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf den Auslöser bei allem, was lebt: ein Vogel, ein Insekt, ein Pilz, eine Blume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa el obturador ante cualquier ser vivo: un pájaro, un insecto, un hongo, una flor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le déclencheur pour tout ce qui est vivant : un oiseau, un insecte, un champignon, une fleur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca l'otturatore su qualsiasi essere vivente: un uccello, un insetto, un fungo, un fiore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鳥、虫、キノコ、花など、生きているものでシャッターをタップしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새, 벌레, 버섯, 꽃 등 살아 있는 무엇이든 셔터를 탭하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij migawki, celując w coś żywego: ptaka, owada, grzyba, kwiat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no obturador para qualquer ser vivo: um pássaro, um inseto, um cogumelo, uma flor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对准任何生物点按快门：鸟、虫、蘑菇或花朵。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對準任何生物，按下快門：鳥、昆蟲、蘑菇或花朵。"
          }
        }
      }
    },
