    "No active Living Dex Pro purchase was found on this Apple ID. If you subscribed on another device, sign in with the same Apple ID and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Apple-ID wurde kein aktiver Living-Dex-Pro-Kauf gefunden. Wenn du auf einem anderen Gerät abonniert hast, melde dich mit derselben Apple-ID an und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró ninguna compra activa de Living Dex Pro con este ID de Apple. Si te suscribiste en otro dispositivo, inicia sesión con el mismo ID de Apple e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun achat Living Dex Pro actif n'a été trouvé pour cet identifiant Apple. Si vous vous êtes abonné sur un autre appareil, connectez-vous avec le même identifiant Apple et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con questo ID Apple non è stato trovato nessun acquisto attivo di Living Dex Pro. Se ti sei abbonato su un altro dispositivo, accedi con lo stesso ID Apple e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Apple ID では有効な Living Dex Pro の購入が見つかりませんでした。別の端末で登録した場合は、同じ Apple ID でサインインしてもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Apple ID에서 활성 Living Dex Pro 구매를 찾지 못했어요. 다른 기기에서 구독했다면 같은 Apple ID로 로그인해 다시 시도해 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie znaleziono aktywnego zakupu Living Dex Pro na tym Apple ID. Jeśli subskrybowałeś na innym urządzeniu, zaloguj się tym samym Apple ID i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma compra ativa do Living Dex Pro foi encontrada neste Apple ID. Se você assinou em outro aparelho, entre com o mesmo Apple ID e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Apple ID 上未找到有效的 Living Dex Pro 购买记录。如果你在其他设备上订阅，请使用同一 Apple ID 登录后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Apple ID 上找不到有效的 Living Dex Pro 購買項目。如果你是在其他裝置上訂閱，請使用同一個 Apple ID 登入後再試一次。"
          }
        }
      }
    },
    "No camera is available right now. You can still identify a photo from your library, or try a sample." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerade ist keine Kamera verfügbar. Du kannst trotzdem ein Foto aus deiner Mediathek identifizieren oder ein Beispiel ausprobieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna cámara disponible ahora mismo. Aun así puedes identificar una foto de tu biblioteca o probar una muestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune caméra n'est disponible pour le moment. Vous pouvez toujours identifier une photo de votre photothèque ou essayer un exemple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna fotocamera disponibile al momento. Puoi comunque identificare una foto dalla libreria o provare un esempio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在利用できるカメラがありません。ライブラリの写真を識別するか、サンプルをお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 사용할 수 있는 카메라가 없어요. 보관함의 사진을 식별하거나 샘플을 써 보세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparat jest teraz niedostępny. Nadal możesz zidentyfikować zdjęcie z biblioteki lub wypróbować przykład."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma câmera está disponível agora. Você ainda pode identificar uma foto da sua biblioteca ou experimentar um exemplo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前没有可用的相机。你仍可以识别资料库中的照片，或试用示例。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前沒有可用的相機。你仍可以識別圖庫中的照片，或試用範例。"
          }
        }
      }
    },
    "No caught species match the current filters." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine gefangenen Arten passen zu den aktuellen Filtern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna especie capturada coincide con los filtros actuales."
          }
        },
