    "Three example species cards: European Robin, Red Fox and Fly Agaric" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre eksempelkort med arter: rødhals, rødræv og fluesvamp"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei Beispiel-Artenkarten: Rotkehlchen, Rotfuchs und Fliegenpilz"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres tarjetas de especies de ejemplo: petirrojo europeo, zorro rojo y Amanita muscaria"
