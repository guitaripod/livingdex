    "There were no previous purchases to restore for this Apple ID." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der var ingen tidligere køb at gendanne for dette Apple-id."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Apple-ID gab es keine früheren Käufe zum Wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No había compras anteriores que restaurar con este ID de Apple."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tälle Apple ID:lle ei ole aiempia ostoja palautettavaksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun achat antérieur à restaurer pour cet identifiant Apple."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engin fyrri kaup voru til að endurheimta fyrir þetta Apple ID."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c'erano acquisti precedenti da ripristinare per questo ID Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Apple ID には、復元できる以前の購入はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Apple ID에는 복원할 이전 구매가 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finnes ingen tidligere kjøp å gjenopprette for denne Apple-ID-en."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak wcześniejszych zakupów do przywrócenia na tym Apple ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há compras anteriores para restaurar neste Apple ID."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns inga tidigare köp att återställa för det här Apple-ID:t."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Apple ID 没有可恢复的先前购买记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Apple ID 沒有可恢復的先前購買項目。"
          }
        }
      }
    },
    "They drink sunlight." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De drikker sollys."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie trinken Sonnenlicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beben luz solar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne juovat auringonvaloa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles boivent la lumière du soleil."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þær drekka sólarljós."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevono luce solare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日光を飲んで生きています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "햇빛을 마시며 살아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De drikker sollys."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piją światło słoneczne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebem luz do sol."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De dricker solljus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们饮用阳光。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它們飲用陽光。"
          }
        }
      }
    },
    "They move, eat, sense." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bevæger sig, spiser og sanser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie bewegen sich, fressen, nehmen wahr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se mueven, comen, perciben."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne liikkuvat, syövät ja aistivat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles bougent, mangent, perçoivent."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þær hreyfa sig, nærast og skynja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si muovono, mangiano, percepiscono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動き、食べ、感じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "움직이고, 먹고, 감지해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De beveger seg, spiser og registrerer omgivelsene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poruszają się, jedzą, czują."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movem-se, comem, percebem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De rör sig, äter, känner av."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们移动、进食、感知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它們移動、進食、感知。"
          }
        }
      }
    },
    "This iPhone has no Apple Intelligence, so Pro writes each catch's entry in the cloud." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne iPhone har ikke Apple Intelligence, så Pro skriver posten for hver fangst i skyen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPhone hat keine Apple Intelligence, deshalb schreibt Pro den Eintrag jedes Fangs in der Cloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone no tiene Apple Intelligence, así que Pro redacta la ficha de cada captura en la nube."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tässä iPhonessa ei ole Apple Intelligencea, joten Pro kirjoittaa jokaisen saaliin merkinnän pilvessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone n'a pas Apple Intelligence, alors Pro rédige la fiche de chaque capture dans le cloud."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þessi iPhone er ekki með Apple Intelligence, þannig að Pro skrifar Dex-færslu hvers fangs í skýinu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo iPhone non ha Apple Intelligence, quindi Pro scrive la scheda di ogni cattura nel cloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この iPhone には Apple Intelligence がないため、Pro が捕獲ごとの記録をクラウドで作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone에는 Apple Intelligence가 없어서 Pro가 포획마다 기록을 클라우드에서 작성해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne iPhonen har ikke Apple Intelligence, så Pro skriver oppføringen for hver fangst i skyen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten iPhone nie ma Apple Intelligence, więc Pro pisze wpis każdego złapanego okazu w chmurze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone não tem Apple Intelligence, então o Pro escreve a entrada de cada captura na nuvem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här iPhonen saknar Apple Intelligence, så Pro skriver Dex-posten för varje fångst i molnet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPhone 不支持 Apple Intelligence，因此 Pro 会在云端为每次捕获撰写条目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台 iPhone 不支援 Apple Intelligence，因此 Pro 會在雲端為每次捕獲撰寫條目。"
          }
        }
      }
    },
    "This permanently deletes your Dex, photos, progress, credits and your Living Dex account on our server. It can't be undone.\n\nAn App Store subscription is not cancelled by this. Manage it in iOS Settings, Apple Account, Subscriptions." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter permanent dit Dex, dine fotos, din fremgang, dine kreditter og din Living Dex-konto på vores server. Det kan ikke fortrydes.\n\nDette opsiger ikke et App Store-abonnement. Administrér det under Indstillinger, Apple-konto, Abonnementer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies löscht deinen Dex, deine Fotos, deinen Fortschritt, deine Credits und dein Living-Dex-Konto auf unserem Server dauerhaft. Das kann nicht rückgängig gemacht werden.\n\nEin App-Store-Abo wird dadurch nicht gekündigt. Verwalte es in den iOS-Einstellungen unter Apple-Account, Abos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina de forma permanente tu Dex, fotos, progreso, créditos y tu cuenta de Living Dex en nuestro servidor. No se puede deshacer.\n\nUna suscripción de la App Store no se cancela con esto. Gestiónala en Ajustes de iOS, Cuenta de Apple, Suscripciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä poistaa pysyvästi Dexisi, kuvasi, edistymisesi, krediittisi ja Living Dex -tilisi palvelimeltamme. Tätä ei voi perua.\n\nTämä ei peruuta App Store -tilausta. Hallinnoi sitä iOS-asetuksista kohdassa Apple-tili, Tilaukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci supprime définitivement votre Dex, vos photos, votre progression, vos crédits et votre compte Living Dex sur notre serveur. C'est irréversible.\n\nUn abonnement à l'App Store n'est pas résilié par cette action. Gérez-le dans les Réglages iOS, section Compte Apple, Abonnements."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta eyðir varanlega Dex-inn þinn, myndirnar þínar, framfarirnar þínar, inneignirnar þínar og Living Dex aðganginn þinn á þjóninum okkar. Ekki er hægt að afturkalla það.\n\nÁskriftinni í App Store er ekki sagt upp með þessu. Stjórnaðu henni í iOS-stillingum undir Apple-aðgangi, Áskriftir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo elimina in modo permanente il tuo Dex, le foto, i progressi, i crediti e il tuo account Living Dex sul nostro server. Non può essere annullato.\n\nUn abbonamento dell'App Store non viene annullato da questa operazione. Gestiscilo nelle Impostazioni di iOS, Account Apple, Abbonamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作で、Dex、写真、進行状況、クレジット、サーバー上の Living Dex アカウントが完全に削除されます。元に戻すことはできません。\n\nこの操作では App Store のサブスクリプションは解約されません。iOS の設定、Apple アカウント、サブスクリプションから管理してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업은 Dex, 사진, 진행 상황, 크레딧과 서버의 Living Dex 계정을 영구적으로 삭제해요. 되돌릴 수 없어요.\n\n이 작업으로 App Store 구독은 해지되지 않아요. iOS 설정, Apple 계정, 구독에서 관리하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter Dex-en din, bildene dine, fremgangen din, kredittene dine og Living Dex-kontoen din på serveren vår for godt. Dette kan ikke angres.\n\nEt App Store-abonnement avsluttes ikke av dette. Administrer det i iOS-innstillingene under Apple-konto, Abonnementer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwale usuwa to Twój Dex, zdjęcia, postępy, kredyty i konto Living Dex na naszym serwerze. Nie można tego cofnąć.\n\nTo nie anuluje subskrypcji App Store. Zarządzaj nią w Ustawieniach iOS, w sekcji Apple ID, Subskrypcje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto exclui permanentemente seu Dex, fotos, progresso, créditos e sua conta do Living Dex no nosso servidor. Não é possível desfazer.\n\nUma assinatura da App Store não é cancelada por isto. Gerencie-a em Ajustes do iOS, Conta Apple, Assinaturas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta raderar permanent ditt Dex, dina foton, dina framsteg, dina krediter och ditt Living Dex-konto på vår server. Det kan inte ångras.\n\nEn prenumeration i App Store avbryts inte av detta. Hantera den i iOS-inställningar, Apple-konto, Prenumerationer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除你的 Dex、照片、进度、积分以及你在我们服务器上的 Living Dex 账户，且无法撤销。\n\nApp Store 订阅不会因此取消。请在 iOS“设置”、Apple 账户、订阅中管理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將永久刪除你的 Dex、照片、進度、點數，以及我們伺服器上的 Living Dex 帳號。此操作無法復原。\n\nApp Store 訂閱不會因此取消。請在 iOS 的「設定」、Apple 帳號、訂閱中管理。"
          }
        }
      }
    },
    "This realm holds life that doesn't fit the others — chiefly bacteria and archaea, single cells so simple they don't even keep their DNA in a nucleus, yet the most abundant and ancient life on Earth. It also gathers the oddballs, like viruses, which sit right on the blurry border of \"alive.\" You mostly meet these as colonies or their handiwork." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette rige rummer liv, der ikke passer ind i de andre: hovedsageligt bakterier og arkæer, encellede organismer så simple, at de ikke engang har deres DNA i en cellekerne, men alligevel det mest talrige og ældste liv på Jorden. Det samler også særlinge som vira, der ligger lige på den uskarpe grænse til »levende«. Du møder dem oftest som kolonier eller via deres spor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Reich umfasst Leben, das in keine der anderen passt: vor allem Bakterien und Archaeen, Einzeller, so einfach, dass sie ihre DNA nicht einmal in einem Zellkern tragen, und doch das häufigste und älteste Leben der Erde. Hier landen auch Außenseiter wie Viren, die genau an der unscharfen Grenze zu „lebendig“ sitzen. Du begegnest ihnen meist als Kolonien oder in ihren Spuren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este reino reúne la vida que no encaja en los demás: sobre todo bacterias y arqueas, células tan simples que ni siquiera guardan su ADN en un núcleo, pero la vida más abundante y antigua de la Tierra. También incluye a los bichos raros, como los virus, que se sitúan justo en la frontera difusa de lo «vivo». Normalmente los encuentras como colonias o por lo que hacen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tähän valtakuntaan kuuluu elämä, joka ei sovi muihin: pääasiassa bakteerit ja arkkieliöt, yksisoluiset, jotka ovat niin yksinkertaisia, etteivät ne edes säilytä DNA:taan tumassa, ja silti Maan runsaslukuisinta ja vanhinta elämää. Siihen kuuluvat myös erikoisuudet, kuten virukset, jotka istuvat juuri ”elävän” hämärällä rajalla. Kohtaat näitä yleensä pesäkkeinä tai niiden jälkinä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce règne rassemble le vivant qui ne rentre dans aucun autre : surtout bactéries et archées, des cellules si simples qu'elles ne logent même pas leur ADN dans un noyau, pourtant la vie la plus abondante et la plus ancienne de la Terre. On y range aussi des cas particuliers comme les virus, à la frontière floue du « vivant ». On les rencontre surtout sous forme de colonies ou à travers leurs traces."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta ríki geymir líf sem passar ekki í hin: fyrst og fremst bakteríur og archaea, einfrumungar svo einfaldar að þær geyma ekki einu sinni DNA sitt í frumukjarna, samt algengasta og elsta líf jarðar. Hér lenda líka furðuverurnar, eins og veirur, sem sitja á óskýru mörkum „lifandi“. Þú hittir þær helst sem nýlendur eða verksummerki þeirra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo regno comprende la vita che non rientra negli altri: soprattutto batteri e archeobatteri, cellule così semplici da non custodire nemmeno il DNA in un nucleo, eppure la forma di vita più abbondante e antica della Terra. Include anche le stranezze, come i virus, che stanno proprio al confine sfumato di ciò che è \"vivo\". Di solito li incontri come colonie o per ciò che producono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この界には、ほかの界に当てはまらない生命が含まれます。主に細菌と古細菌で、DNA を核に収めてさえいないほど単純な単細胞ですが、地球上で最も数が多く、最も古い生命です。ウイルスなど、「生きている」の曖昧な境界線上にいる変わり者もここに分類されます。ふつうはコロニーやその痕跡として見かけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 계에는 다른 계에 맞지 않는 생명이 모여 있어요. 주로 세균과 고세균이며, DNA를 핵에도 담지 않을 만큼 단순한 단세포이지만, 지구에서 가장 많고 가장 오래된 생명이에요. 또 \"살아 있음\"의 흐릿한 경계에 있는 바이러스 같은 기이한 존재도 여기에 속해요. 대개 군집이나 그들이 남긴 흔적으로 만나게 돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette riket omfatter liv som ikke passer inn i de andre, først og fremst bakterier og arkéer, encellede organismer så enkle at de ikke en gang har DNA-et sitt i en cellekjerne, og likevel det mest tallrike og eldste livet på jorden. Her havner også særlinger som virus, som sitter helt på den uskarpe grensen til «levende». Du møter dem oftest som kolonier eller som spor etter aktiviteten deres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To królestwo obejmuje życie, które nie pasuje do pozostałych: głównie bakterie i archeony, pojedyncze komórki tak proste, że nie trzymają DNA w jądrze, a zarazem najliczniejsze i najstarsze życie na Ziemi. Mieszczą się tu też dziwaki, na przykład wirusy, które leżą na rozmytej granicy \"życia\". Najczęściej spotyka się je jako kolonie albo po śladach ich działalności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este reino abriga vida que não se encaixa nos outros, principalmente bactérias e arqueias, células tão simples que nem mantêm o DNA num núcleo, mas a vida mais abundante e antiga da Terra. Ele também reúne seres excêntricos, como os vírus, que ficam na fronteira nebulosa do que é \"vivo\". Você costuma encontrar esses seres como colônias ou pelas obras que deixam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här riket rymmer liv som inte passar in i de andra, främst bakterier och arkéer. Det är encelliga organismer så enkla att de inte ens har sitt DNA i en cellkärna, men ändå den vanligaste och äldsta livsformen på jorden. Här hör också udda fall som virus, som ligger precis på den suddiga gränsen till ”levande”. Du möter oftast dessa som kolonier eller som deras verk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这一界收纳了不属于其他各界的生命，主要是细菌和古菌：它们是没有细胞核、结构极其简单的单细胞生物，却是地球上数量最多、历史最悠久的生命。这里还包括病毒等怪异生命，它们正位于“是否活着”这一模糊边界上。你通常只会以菌落或它们造成的痕迹的形式遇到它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這一界收納不屬於其他各界的生命，主要是細菌與古菌：它們是沒有細胞核、結構極為簡單的單細胞生物，卻是地球上數量最多、歷史最悠久的生命。這裡也收錄了病毒等怪異的生命，它們正位於「是否活著」的模糊邊界上。你通常只會以菌落或它們留下的痕跡遇見它們。"
          }
        }
      }
    },
    "This removes it from your dex, along with your photos of it. This can't be undone." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette fjerner den fra dit Dex sammen med dine fotos af den. Det kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das entfernt sie aus deinem Dex, zusammen mit deinen Fotos davon. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto la elimina de tu Dex, junto con tus fotos de ella. No se puede deshacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä poistaa sen Dexistäsi sekä siitä ottamasi kuvat. Tätä ei voi perua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela la retire de votre Dex, ainsi que vos photos de cette espèce. C'est irréversible."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta fjarlægir hana úr Dex-inum þínum ásamt myndunum þínum af henni. Ekki er hægt að afturkalla það."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo la rimuove dal tuo Dex, insieme alle tue foto di essa. Non può essere annullato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dex からこの記録を、写真とともに削除します。元に戻すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dex에서 이 기록을 사진과 함께 삭제해요. 되돌릴 수 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette fjerner den fra Dex-en din, sammen med bildene dine av den. Dette kan ikke angres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To usunie go z Twojego Dex, razem z Twoimi zdjęciami. Nie można tego cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto remove a espécie do seu Dex, junto com suas fotos dela. Não é possível desfazer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta tar bort den från ditt Dex, tillsammans med dina foton av den. Det kan inte ångras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会将它从你的 Dex 中移除，连同你为它拍摄的照片一起删除。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會將它從你的 Dex 中移除，連同你為它拍攝的照片一併刪除。此操作無法復原。"
          }
        }
      }
    },
