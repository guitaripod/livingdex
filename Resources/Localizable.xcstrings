    "Point at anything alive and identify it as often as you like — no credit balance to top up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte die Kamera auf alles Lebendige und identifiziere es so oft du willst, ohne Credit-Guthaben aufzuladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta a cualquier ser vivo e identifícalo tantas veces como quieras, sin saldo de créditos que recargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointez n'importe quel être vivant et identifiez-le autant de fois que vous voulez, sans crédit à recharger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punta su qualsiasi essere vivente e identificalo quante volte vuoi, senza saldo crediti da ricaricare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生きているものに向けて、好きなだけ識別できます。チャージするクレジット残高は必要ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "살아 있는 무엇이든 가리키고 원하는 만큼 식별하세요. 채워 넣을 크레딧 잔액은 필요 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celuj w dowolny żywy organizm i identyfikuj go, ile chcesz, bez doładowywania salda kredytów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aponte para qualquer ser vivo e identifique quantas vezes quiser, sem saldo de créditos para recarregar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
