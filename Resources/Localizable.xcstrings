    "Turn on location to reveal the species living near you — your Regional Dex." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere den Standort, um die Arten in deiner Nähe aufzudecken, deinen regionalen Dex."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa la ubicación para revelar las especies que viven cerca de ti: tu Dex regional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez la localisation pour révéler les espèces qui vivent près de vous : votre Dex régional."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva la posizione per rivelare le specie che vivono vicino a te: il tuo Dex regionale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報をオンにして、近くに生息する種、つまり地域の Dex を明らかにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치를 켜서 근처에 사는 종, 즉 지역 Dex를 드러내 보세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz lokalizację, by odkryć gatunki żyjące w pobliżu: Twój Dex regionalny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative a localização para revelar as espécies que vivem perto de você: seu Dex Regional."
